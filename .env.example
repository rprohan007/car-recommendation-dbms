# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env.local: cp .env.example .env.local
# NEVER commit .env.local containing real credentials to Git.
# ==============================================================================

# PostgreSQL Connection String (requires pgvector extension)
# Format: postgresql://[user[:password]@][host][:port][/database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardb"

# NextAuth Canonical App URL
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Cryptographic Secret (used to sign session JWTs)
# Generate a cryptographically secure 32-byte secret using:
#   openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_32_CHAR_RANDOM_SECRET"

# Optional: OpenAI API Key for 1536-dimensional text-embedding-3-small neural embeddings
# If left empty, the engine transparently operates in multi-attribute keyword mode.
OPENAI_API_KEY=""

# Environment Mode (development | production | test)
NODE_ENV="development"
