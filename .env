# PostgreSQL connection string with pgvector extension enabled
# Format: postgresql://[user[:password]@][host][:port][/database][?params]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardb"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="car-recommendation-dbms-nextauth-super-secret-key-2026"

# OpenAI API Key for generating text-embedding-3-small (1536-dimensional) embeddings
# If omitted or invalid, the backend automatically uses a deterministic 1536-dim embedding fallback
OPENAI_API_KEY="your-openai-api-key-here"
